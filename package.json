{
  "name": "bogota-ciclorutas",
  "private": true,
  "version": "0.4.0",
  "description": "Visor de las ciclorrutas de Bogotá sobre el relieve de la ciudad, con cálculo de rutas y perfil de elevación.",
  "license": "MIT",
  "author": "José Díaz Rincón",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diazrincon/bogota-ciclorutas.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data": "python3 scripts/gpkg_to_geojson.py && python3 scripts/descargar_redes.py && python3 scripts/descargar_mdt.py && python3 scripts/construir_red.py && python3 scripts/construir_etiquetas.py",
    "app": "vite build && electron .",
    "app:build": "vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "maplibre-gl": "^5.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.diazrincon.ciclorrutas-bogota",
    "productName": "Ciclorrutas de Bogota",
    "executableName": "ciclorrutas-bogota",
    "artifactName": "ciclorrutas-bogota-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.navigation",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "CFBundleDisplayName": "Ciclorrutas de Bogotá"
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Science"
    }
  }
}
